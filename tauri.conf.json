{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "center": true,
        "fullscreen": false,
        "height": 720,
        "label": "main",
        "minHeight": 600,
        "minWidth": 960,
        "resizable": true,
        "title": "Lingxiao AI Manager",
        "width": 1100
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "ui/dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icon.ico"
    ],
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "identifier": "com.lingxiao.ai-manager",
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "productName": "Lingxiao AI Manager",
  "version": "0.0.5"
}
